% =================================================
% Professional Summary
% =================================================
\section{Professional Summary}

Senior Backend Engineer specializing in geospatial systems and artificial
intelligence, with more than 12 years of professional experience in software
development, spatial platforms, API design, data-intensive applications, and
geospatial research and development. Experienced in building Python backend
services, spatial databases, risk-assessment platforms, claims-management
solutions, Sensor Web systems, and natural-language-to-map applications.

Combines backend engineering, GIS, and AI/LLM orchestration to design modular,
maintainable, and extensible software. Proven experience leading a 
technical team, mentoring developers, building independent products, creating
Persian technical education, and contributing to open-source geospatial
software. Recognized as an OSGeo Advocate and actively involved in the
open-source and geospatial communities.

% =================================================
% Core Expertise
% =================================================
\section{Core Expertise}

\skillrow{Backend Engineering}{
Python, Django, Django REST Framework, FastAPI, Flask, REST APIs,
GraphQL, Celery, asynchronous processing, WebSockets, authentication,
and service-oriented backend development
}

\skillrow{Geospatial Engineering}{
PostGIS, GeoDjango, GDAL/OGR, QGIS, ArcGIS, ArcPy, Shapely,
GeoJSON, Leaflet, spatial analysis, remote sensing, map-based applications,
OGC standards, Sensor Web, and Sensor Web Enablement
}

\skillrow{AI and LLM Systems}{
LLM orchestration, natural-language geospatial interfaces,
tool-using AI systems, plugin-based AI architectures, cascading request
routing, Model Context Protocol concepts, machine learning, scikit-learn,
Pandas, and NumPy
}

\skillrow{Data and Infrastructure}{
PostgreSQL, PostGIS, MongoDB, Redis, Microsoft SQL Server, MySQL,
Elasticsearch, RabbitMQ, MQTT, Linux, Git, GitHub, Docker, testing,
deployment, and data integration
}

\skillrow{Leadership}{
Technical leadership, team coordination, developer mentoring,
architecture planning, research and development, product development,
technical education, and open-source collaboration
}

